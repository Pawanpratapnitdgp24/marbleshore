-- Code Generated by Sidekick is for learning and experimentation purposes only.
-- filename: proposed-main-source-query.sql

SELECT
    s.srm_outgoing_transaction_id AS old_srm_outgoing_transaction_id,
    CASE
        WHEN SUBSTR(s.srm_outgoing_transaction_id, 1, 2) = 'MP'
            THEN 'SP' || SUBSTR(s.srm_outgoing_transaction_id, 3)
        WHEN SUBSTR(s.srm_outgoing_transaction_id, 1, 2) = 'ML'
            THEN 'SL' || SUBSTR(s.srm_outgoing_transaction_id, 3)
        ELSE s.srm_outgoing_transaction_id
    END AS new_srm_outgoing_transaction_id,
    s.system_id AS old_system_id,
    CASE
        WHEN SUBSTR(s.srm_outgoing_transaction_id, 1, 2) = 'MP'
            THEN 'SP'
        WHEN SUBSTR(s.srm_outgoing_transaction_id, 1, 2) = 'ML'
            THEN 'SL'
        ELSE s.system_id
    END AS new_system_id,
    s.policy_no,
    s.policy_eff_dt,
    s.accounting_dt
FROM #PS_PCG_EDW.$PCG_EDW_Stage_Schema#.stage_srm_premium_loss s
WHERE SUBSTR(TO_CHAR(s.accounting_dt), 1, 6) = '#AccMnth#'
  AND SUBSTR(s.srm_outgoing_transaction_id, 1, 2) IN ('MP', 'ML')
  AND EXISTS (
        SELECT 1
        FROM tpolicy p
        WHERE TRIM(p.policy_no) = TRIM(s.policy_no)
          AND TRIM(p.policy_type_cd) = 'GRX'
          AND TRIM(p.source_system_nm) = 'Salesforce'
          AND p.source_system_sk IN (23, 24)
  );
