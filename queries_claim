SELECT
    l.claim_sk,
    l.claim_feature_sk,

    l.other_recovery_am,
    l.loss_reserve_am,
    l.expense_reserve_am,
    l.loss_paid_am,
    l.expense_paid_am,
    l.salvage_recovery_am,
    l.subro_recovery_am,

    CASE
        WHEN NVL(l.other_recovery_am,0) <> 0
          OR NVL(l.loss_reserve_am,0) <> 0
          OR NVL(l.expense_reserve_am,0) <> 0
          OR NVL(l.loss_paid_am,0) <> 0
          OR NVL(l.expense_paid_am,0) <> 0
          OR NVL(l.salvage_recovery_am,0) <> 0
          OR NVL(l.subro_recovery_am,0) <> 0
        THEN 'AMOUNT EXISTS'
        ELSE 'NO AMOUNT'
    END AS AMOUNT_RESULT

FROM tclaim_transaction l
WHERE l.claim_sk = :claim_sk;
